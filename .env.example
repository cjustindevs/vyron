APP_NAME=VYRON
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://vyron.onrender.com

# Run: php artisan key:generate --force  (iron the APP_KEY string into .env or set APP_KEY=base64:... in Render)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Use stderr on Render so exceptions stream to the Runtime Logs tab
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Render (PostgreSQL) — set DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD
# and DB_CONNECTION=pgsql in the Render dashboard. Locally, MySQL/SQLite still works.
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=vyron
DB_USERNAME=vyron
DB_PASSWORD=

# MySQL fallback (local dev)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=vyron
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ====== HUGGINGFACE API ======
HF_API_KEY=YOUR_HUGGINGFACE_API_KEY_HERE
HF_MODEL=gpt2

# ====== GOOGLE GEMINI API ======
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048

# ====== GROQ API ======
# Get a free key (no card required): https://console.groq.com/keys
# Set GROQ_API_KEY in Render -> Environment (never commit real keys to git)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=2048
GROQ_TIMEOUT=60

# ====== RENDER DEPLOYMENT ======
# Port Render expects the web server to listen on (defaults to 10000 on Render,
# 80 locally). The Docker entrypoint reads this automatically.
PORT=10000

# Secret token used by public/migrate.php. Pick a long random string and set the
# same value in Render. DELETE public/migrate.php once migrations are done.
MIGRATE_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING
